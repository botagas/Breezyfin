{
	"name": "breezyfin",
	"version": "0.2.1",
	"description": "Jellyfin client for LG webOS TVs, built with Enact Sandstone.",
	"author": "",
	"main": "src/index.js",
	"scripts": {
		"serve": "enact serve",
		"prepack": "npm run prepare:release-notices && npm run prepare:subtitle-package-assets",
		"pack": "enact pack --no-linting",
		"postpack": "BREEZYFIN_PACK_MODE=development npm run copy:subtitle-assets",
		"prepack-p": "npm run prepare:release-notices && npm run prepare:subtitle-package-assets",
		"pack-p": "enact pack -p --content-hash --no-linting",
		"postpack-p": "BREEZYFIN_PACK_MODE=production npm run copy:subtitle-assets",
		"watch": "enact pack --watch",
		"clean": "enact clean",
		"prepare:release-notices": "node scripts/generate-third-party-notices.cjs",
		"prepare:subtitle-package-assets": "node scripts/prepare-subtitle-package-assets.cjs",
		"copy:subtitle-assets": "node scripts/copy-subtitle-assets.cjs",
		"lint": "enact lint --local",
		"audit": "npm run audit:docs && npm run audit:script-refs && npm run audit:audit-scripts && npm run audit:command-paths && npm run audit:view-docs && npm run audit:helper-docs && npm run audit:metadata && npm run audit:runtime-debug && npm run audit:sensitive-logging && npm run audit:portability && npm run audit:repository-hygiene && npm run audit:runtime-deps && npm run audit:licenses && npm run audit:service-boundaries && npm run audit:import-cycles && npm run audit:hotspots && npm run audit:styles && npm run audit:style-imports && npm run audit:style-entries && npm run audit:style-reachability && npm run audit:stylelint && npm run audit:style-vars && npm run audit:style-tokens && npm run audit:js-colors && npm run audit:duplicates && npm run audit:jscpd",
		"audit:docs": "node scripts/docs-audit/find-missing-doc-paths.cjs",
		"audit:script-refs": "node scripts/docs-audit/find-missing-npm-scripts.cjs",
		"audit:audit-scripts": "node scripts/docs-audit/find-audit-script-drift.cjs",
		"audit:command-paths": "node scripts/docs-audit/find-missing-command-paths.cjs",
		"audit:view-docs": "node scripts/docs-audit/find-panel-doc-drift.cjs",
		"audit:helper-docs": "node scripts/docs-audit/find-helper-doc-drift.cjs",
		"audit:metadata": "node scripts/code-audit/find-metadata-drift.cjs",
		"audit:runtime-debug": "node scripts/code-audit/find-runtime-debug-statements.cjs",
		"audit:sensitive-logging": "node scripts/code-audit/find-sensitive-runtime-logging.cjs",
		"audit:portability": "node scripts/code-audit/find-portability-leaks.cjs",
		"audit:repository-hygiene": "node scripts/code-audit/find-repository-hygiene-issues.cjs",
		"audit:runtime-deps": "node scripts/code-audit/find-runtime-dependency-drift.cjs",
		"audit:licenses": "node scripts/generate-third-party-notices.cjs --check",
		"audit:service-boundaries": "node scripts/code-audit/find-service-boundary-violations.cjs",
		"audit:import-cycles": "node scripts/code-audit/find-import-cycles.cjs",
		"audit:hotspots": "node scripts/code-audit/find-hotspots.cjs",
		"audit:hotspots:update": "node scripts/code-audit/find-hotspots.cjs --write-baseline",
		"audit:styles": "node scripts/style-audit/find-dead-css-modules.cjs",
		"audit:style-imports": "node scripts/style-audit/find-style-import-drift.cjs",
		"audit:style-entries": "node scripts/style-audit/find-style-entry-drift.cjs",
		"audit:style-reachability": "node scripts/style-audit/find-style-reachability.cjs",
		"audit:stylelint": "stylelint \"src/**/*.{css,less}\"",
		"audit:style-vars": "node scripts/style-audit/find-css-var-drift.cjs",
		"audit:style-tokens": "node scripts/style-audit/find-raw-color-usage.cjs",
		"audit:js-colors": "node scripts/style-audit/find-js-raw-color-usage.cjs",
		"license": "enact license",
		"test": "enact test",
		"test-watch": "enact test --watch",
		"audit:duplicates": "node scripts/duplicate-audit/find-duplicates.cjs",
		"audit:jscpd": "jscpd --config .jscpd.json --no-tips --exit-code 1 src scripts",
		"report:package-size": "node scripts/report-package-size.cjs"
	},
	"license": "GPL-3.0-only",
	"private": true,
	"repository": {
		"type": "git",
		"url": "git+https://github.com/botagas/Breezyfin.git"
	},
	"homepage": "https://github.com/botagas/Breezyfin#readme",
	"bugs": {
		"url": "https://github.com/botagas/Breezyfin/issues"
	},
	"enact": {
		"alias": {
			"react-is": "react-is-18"
		},
		"theme": "sandstone",
		"publicUrl": "."
	},
	"dependencies": {
		"@enact/core": "4.9.8",
		"@enact/i18n": "4.9.8",
		"@enact/sandstone": "2.9.13",
		"@enact/spotlight": "4.9.8",
		"@enact/ui": "4.9.8",
		"@enact/webos": "4.9.8",
		"@jellyfin/sdk": "^0.13.0",
		"assjs": "^0.1.8",
		"axios": "^1.18.1",
		"hls.js": "^1.6.15",
		"ilib": "14.21.1",
		"jassub": "2.5.6",
		"libass-wasm": "^4.1.0",
		"libbitsub": "^1.10.1",
		"libpgs": "^0.8.1",
		"prop-types": "^15.8.1",
		"react": "18.3.1",
		"react-dom": "18.3.1",
		"web-vitals": "^3.5.1"
	},
	"devDependencies": {
		"@babel/parser": "7.29.7",
		"@enact/cli": "7.3.3",
		"@testing-library/dom": "10.4.1",
		"@testing-library/react": "16.3.2",
		"@testing-library/user-event": "14.6.1",
		"baseline-browser-mapping": "^2.10.0",
		"jscpd": "^5.0.11",
		"postcss-less": "^6.0.0",
		"react-is-18": "npm:react-is@18.3.1",
		"stylelint": "^17.13.0"
	},
	"overrides": {
		"brace-expansion@<2.0.0": "1.1.16",
		"brace-expansion@>=2.0.0 <5.0.0": "2.1.2",
		"brace-expansion@>=5.0.0 <5.0.8": "5.0.8",
		"fast-uri@<3.1.4": "3.1.4",
		"js-yaml@>=4.0.0 <4.3.0": "4.3.0"
	},
	"jest": {
		"moduleNameMapper": {
			"^@jellyfin/sdk/lib/utils/api/sync-play-api$": "<rootDir>/src/testUtils/mocks/jellyfinSyncPlayApi.js",
			"^@jellyfin/sdk/lib/utils/api/time-sync-api$": "<rootDir>/src/testUtils/mocks/jellyfinSyncPlayApi.js",
			"^react$": "<rootDir>/node_modules/react",
			"^react/jsx-runtime$": "<rootDir>/node_modules/react/jsx-runtime.js",
			"^react/jsx-dev-runtime$": "<rootDir>/node_modules/react/jsx-dev-runtime.js",
			"^react-dom$": "<rootDir>/node_modules/react-dom",
			"^react-dom/(.*)$": "<rootDir>/node_modules/react-dom/$1",
			"^react-is$": "<rootDir>/node_modules/react-is",
			"^@testing-library/react$": "<rootDir>/node_modules/@testing-library/react"
		}
	}
}
