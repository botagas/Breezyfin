{
	"name": "breezyfin",
	"version": "0.1.9",
	"description": "Jellyfin client for LG webOS TVs, built with Enact Sandstone.",
	"author": "",
	"main": "src/index.js",
	"scripts": {
		"serve": "enact serve",
		"prepack": "npm run prepare:subtitle-package-assets",
		"pack": "enact pack",
		"postpack": "BREEZYFIN_PACK_MODE=development npm run copy:subtitle-assets",
		"prepack-p": "npm run prepare:subtitle-package-assets",
		"pack-p": "enact pack -p --content-hash",
		"postpack-p": "BREEZYFIN_PACK_MODE=production npm run copy:subtitle-assets",
		"watch": "enact pack --watch",
		"clean": "enact clean",
		"prepare:subtitle-package-assets": "node scripts/prepare-subtitle-package-assets.cjs",
		"copy:subtitle-assets": "node scripts/copy-subtitle-assets.cjs",
		"lint": "enact lint .",
		"audit": "npm run audit:docs && npm run audit:script-refs && npm run audit:audit-scripts && npm run audit:command-paths && npm run audit:view-docs && npm run audit:helper-docs && npm run audit:metadata && npm run audit:runtime-debug && npm run audit:portability && npm run audit:service-boundaries && npm run audit:import-cycles && npm run audit:hotspots && npm run audit:styles && npm run audit:style-imports && npm run audit:style-entries && npm run audit:style-reachability && npm run audit:stylelint && npm run audit:style-vars && npm run audit:style-tokens && npm run audit:js-colors && npm run audit:duplicates && npm run audit:jscpd",
		"audit:docs": "node scripts/docs-audit/find-missing-doc-paths.cjs",
		"audit:script-refs": "node scripts/docs-audit/find-missing-npm-scripts.cjs",
		"audit:audit-scripts": "node scripts/docs-audit/find-audit-script-drift.cjs",
		"audit:command-paths": "node scripts/docs-audit/find-missing-command-paths.cjs",
		"audit:view-docs": "node scripts/docs-audit/find-panel-doc-drift.cjs",
		"audit:helper-docs": "node scripts/docs-audit/find-helper-doc-drift.cjs",
		"audit:metadata": "node scripts/code-audit/find-metadata-drift.cjs",
		"audit:runtime-debug": "node scripts/code-audit/find-runtime-debug-statements.cjs",
		"audit:portability": "node scripts/code-audit/find-portability-leaks.cjs",
		"audit:service-boundaries": "node scripts/code-audit/find-service-boundary-violations.cjs",
		"audit:import-cycles": "node scripts/code-audit/find-import-cycles.cjs",
		"audit:hotspots": "node scripts/code-audit/find-hotspots.cjs",
		"audit:styles": "node scripts/style-audit/find-dead-css-modules.cjs",
		"audit:style-imports": "node scripts/style-audit/find-style-import-drift.cjs",
		"audit:style-entries": "node scripts/style-audit/find-style-entry-drift.cjs",
		"audit:style-reachability": "node scripts/style-audit/find-style-reachability.cjs",
		"audit:stylelint": "stylelint \"src/**/*.{css,less}\"",
		"audit:style-vars": "node scripts/style-audit/find-css-var-drift.cjs",
		"audit:style-tokens": "node scripts/style-audit/find-raw-color-usage.cjs",
		"audit:js-colors": "node scripts/style-audit/find-js-raw-color-usage.cjs",
		"license": "enact license",
		"test": "enact test",
		"test-watch": "enact test --watch",
		"audit:duplicates": "node scripts/duplicate-audit/find-duplicates.cjs",
		"audit:jscpd": "jscpd --config .jscpd.json --no-tips --exit-code 1 src scripts"
	},
	"license": "UNLICENSED",
	"private": true,
	"repository": "",
	"enact": {
		"theme": "sandstone"
	},
	"eslintConfig": {
		"extends": "enact-proxy"
	},
	"eslintIgnore": [
		"node_modules/*",
		"build/*",
		"dist/*"
	],
	"dependencies": {
		"@enact/core": "^4.8.0",
		"@enact/i18n": "^4.8.0",
		"@enact/sandstone": "^2.8.0",
		"@enact/spotlight": "^4.8.0",
		"@enact/ui": "^4.8.0",
		"@enact/webos": "^5.3.2",
		"@jellyfin/sdk": "^0.13.0",
		"assjs": "^0.1.8",
		"hls.js": "^1.6.15",
		"ilib": "^14.19.0",
		"jassub": "^2.5.6",
		"libass-wasm": "^4.1.0",
		"prop-types": "^15.8.1",
		"react": "^18.2.0",
		"react-dom": "^18.2.0",
		"web-vitals": "^3.5.1"
	},
	"devDependencies": {
		"@enact/cli": "^7.2.1",
		"baseline-browser-mapping": "^2.10.0",
		"eslint-config-enact-proxy": "^1.0.7",
		"jscpd": "^5.0.11",
		"postcss-less": "^6.0.0",
		"stylelint": "^17.13.0"
	}
}
